# Remotion-with-jepoy.dev
# (promo-studio/.gitignore covers the Remotion app: node_modules, out, .env, .app-profile, .cache …)

# Per-machine installs — rebuilt by setup on every OS
node_modules/
tools/.venv/
__pycache__/
*.pyc

# Secrets
.env
.env.*

# Historical workspace-root media. Keep these folders and their contents untouched.
# New work is stored under promo-studio/inbox/ and promo-studio/out/ (ignored there).
# Only each legacy folder's README is tracked.
00_INBOX/*
!00_INBOX/README.txt
20_RENDERS/*
!20_RENDERS/README.txt
30_DELIVERY/*
!30_DELIVERY/README.txt
90_ARCHIVE/*
!90_ARCHIVE/README.txt

# Tool/OS clutter
.playwright-mcp/
.remotion/
.DS_Store
Thumbs.db
desktop.ini
