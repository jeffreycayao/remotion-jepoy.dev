# Remotion-with-jepoy.dev
# (promo-studio/.gitignore covers the Remotion app: node_modules, out, .env, .app-profile, .cache …)

# Per-machine installs — rebuilt by setup on every OS
node_modules/
tools/.venv/
__pycache__/
*.pyc

# Secrets
.env
.env.*

# Removed workspace-root media folders (merged into promo-studio/inbox and promo-studio/out).
# Ignored so a stray copy can't bring them back into Git.
00_INBOX/
20_RENDERS/
30_DELIVERY/
90_ARCHIVE/

# Tool/OS clutter
.playwright-mcp/
.remotion/
.DS_Store
Thumbs.db
desktop.ini
