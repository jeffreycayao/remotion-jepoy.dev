  "scripts": {
    "start": "node scripts/launcher.mjs",
    "setup": "node scripts/setup.mjs",
    "sync": "node scripts/sync-projects.mjs",
    "predev": "npm run sync",
    "dev": "remotion studio --port 3100",
    "new": "node scripts/new-project.mjs",
    "prerender": "npm run sync",
    "render": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render.mjs",
    "draft": "npm run sync && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render.mjs --draft",
    "deliver": "node scripts/py.mjs deliver",
    "build": "npm run sync && remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "npm run sync && eslint src && tsc",
    "tools": "node scripts/py.mjs",
    "plugins": "node scripts/plugins.mjs",
    "app": "node scripts/launcher.mjs studio",
    "ai": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai/cli.mjs",
    "frames": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/frames.mjs",
    "autopilot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/autopilot.mjs",
    "chat": "node scripts/ai/chat.mjs",
    "updates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/upgrade.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true,
    "@parcel/watcher@2.6.0": true
