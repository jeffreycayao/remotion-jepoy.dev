{
  "name": "promo-studio",
  "version": "1.0.0",
  "description": "Promo video studio — Remotion templates + production render pipeline",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@huggingface/transformers": "4.2.0",
    "@remotion/animated-emoji": "4.0.534",
    "@remotion/animation-utils": "4.0.534",
    "@remotion/bundler": "4.0.534",
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/effects": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/gif": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/light-leaks": "4.0.534",
    "@remotion/lottie": "4.0.534",
    "@remotion/mac-cursors": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/media-parser": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/preload": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/rough-notation": "4.0.534",
    "@remotion/rounded-text-box": "4.0.534",
    "@remotion/sfx": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "@remotion/starburst": "4.0.534",
    "@remotion/studio": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/video-matting": "4.0.534",
    "@remotion/whisper-webgpu": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "mediabunny": "1.56.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "start": "node scripts/launcher.mjs",
    "setup": "node scripts/setup.mjs",
    "sync": "node scripts/sync-projects.mjs",
    "predev": "npm run sync",
    "dev": "remotion studio --port 3100",
    "new": "node scripts/new-project.mjs",
    "prerender": "npm run sync",
    "render": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render.mjs",
    "draft": "npm run sync && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render.mjs --draft",
    "deliver": "node scripts/py.mjs deliver",
    "build": "npm run sync && remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "npm run sync && eslint src && tsc",
    "tools": "node scripts/py.mjs",
    "plugins": "node scripts/plugins.mjs",
    "app": "node scripts/launcher.mjs studio",
    "ai": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai/cli.mjs",
    "frames": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/frames.mjs",
    "autopilot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/autopilot.mjs",
    "chat": "node scripts/ai/chat.mjs",
    "updates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/upgrade.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
